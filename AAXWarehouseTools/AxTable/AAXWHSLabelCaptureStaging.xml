	<Name>AAXWHSLabelCaptureStaging</Name>
	<SourceCode>
		<Declaration><![CDATA[
/// <summary>
/// Staging buffer for mobile-flow label capture. The print-path CoC
/// (WhsDocumentRouting_AAXWarehouseTools_Extension) inserts one row per captured ZPL label;
/// the render batch (AAXWHSLabelCaptureRenderService) renders rows to PNG and attaches them
/// to the related work record.
/// </summary>
public class AAXWHSLabelCaptureStaging extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    /// <summary>
    /// Finds a staging row by record id.
    /// </summary>
    /// <param name = "_recId">The record id.</param>
    /// <param name = "_forUpdate">True to select the record for update.</param>
    /// <returns>The staging row, or an empty buffer.</returns>
    public static AAXWHSLabelCaptureStaging find(RecId _recId, boolean _forUpdate = false)
    {
        AAXWHSLabelCaptureStaging staging;

        if (_recId)
        {
            staging.selectForUpdate(_forUpdate);

            select firstonly staging
                where staging.RecId == _recId;
        }

        return staging;
    }

]]></Source>
			</Method>
			<Method>
				<Name>existsForWorkAndHash</Name>
				<Source><![CDATA[
    /// <summary>
    /// Pre-attach dedup check on the (WorkId, ZplHash) index.
    /// </summary>
    public static boolean existsForWorkAndHash(WHSWorkId _workId, AAXWHSZplHash _zplHash)
    {
        // Expression-selects resolve the FROM target as a table name.
        return _workId != ''
            && (select firstonly RecId from aaxWHSLabelCaptureStaging
                where aaxWHSLabelCaptureStaging.WorkId == _workId
                   && aaxWHSLabelCaptureStaging.ZplHash == _zplHash
                   && aaxWHSLabelCaptureStaging.Status == AAXWHSLabelCaptureStatus::Done).RecId != 0;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
