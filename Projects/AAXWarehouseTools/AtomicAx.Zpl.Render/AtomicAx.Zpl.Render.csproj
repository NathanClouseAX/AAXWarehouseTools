<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472 is the AOS deployment target (the ILRepack/model-bin targets below are net472-gated).
         net8.0 is built ONLY so the xunit test project (net8.0) can ProjectReference the library and
         exercise the same source — it ships nothing and does not affect the deployed artifact. -->
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RootNamespace>AtomicAx.Zpl.Render</RootNamespace>
    <AssemblyName>AtomicAx.Zpl.Render</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- DR-2 APPLIED (2026-06-04): unsigned (PublicKeyToken=null) — the .NET Framework runtime
         in the AOS rejects strong-named->unsigned loads (0x80131044); sibling precedent F29/F35. -->
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned per WP-0.2 / F34 / DR-1. -->
    <PackageReference Include="BinaryKits.Zpl.Viewer" Version="1.3.1" />
    <!-- Native asset SOURCE packages (no managed lib): natives are embedded as resources below. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.2" />
    <!-- Merge tool: all managed dependencies are ILRepack-ed INTO AtomicAx.Zpl.Render.dll so the
         X++ payload is ONE standalone assembly. This removes every load-fabric failure mode seen
         live in the AOS: BinaryKits' SkiaSharp reference is rewritten to point inside the merged
         assembly (no Fusion resolution, no duplicate load contexts, no identity collision with
         ElectronicReporting's SkiaSharp/zxing), and SkiaSharp's native LibraryLoader probes next
         to the MERGED assembly's Location (the model bin), which we fully control. -->
    <PackageReference Include="ILRepack" Version="2.0.43">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- net472 needs reference assemblies for the build host. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Natives ship INSIDE the assembly as embedded resources; the NativeLibraryPreloader
       extracts them beside the assembly (or to %TEMP%) and LoadLibrary-s them at first use.
       AOS is x64-only (verified); win-x64 embedded, file-probing fallbacks remain for x86. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <EmbeddedResource Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.1\runtimes\win-x64\native\libSkiaSharp.dll">
      <LogicalName>AAX.Natives.win-x64.libSkiaSharp.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\8.3.1.2\runtimes\win-x64\native\libHarfBuzzSharp.dll">
      <LogicalName>AAX.Natives.win-x64.libHarfBuzzSharp.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Merge the managed payload into ONE assembly. /internalize hides every merged type, so the
       only public surface is AtomicAx.Zpl.Render's own API and merged SkiaSharp/zxing types can
       never clash with ElectronicReporting's copies in the same AOS process. zxing.presentation
       (WPF satellite, never used by BinaryKits) is excluded. -->
  <Target Name="AAXILRepack" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net472' and '$(AAXSkipDeploy)' != 'true'">
    <PropertyGroup>
      <AAXOut>$(OutDir.TrimEnd('\'))</AAXOut>
      <AAXMergedDir>$(OutDir)merged\</AAXMergedDir>
      <AAXILRepackExe>$(NuGetPackageRoot)ilrepack\2.0.43\tools\ILRepack.exe</AAXILRepackExe>
      <AAXRefAsmDir>$(NuGetPackageRoot)microsoft.netframework.referenceassemblies.net472\1.0.3\build\.NETFramework\v4.7.2</AAXRefAsmDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Primary FIRST; its identity/version/attributes win. -->
      <AAXMergeInput Include="$(OutDir)AtomicAx.Zpl.Render.dll" />
      <AAXMergeInput Include="$(OutDir)BinaryKits.Zpl.Viewer.dll" />
      <AAXMergeInput Include="$(OutDir)BinaryKits.Zpl.Label.dll" />
      <AAXMergeInput Include="$(OutDir)SkiaSharp.dll" />
      <AAXMergeInput Include="$(OutDir)SkiaSharp.HarfBuzz.dll" />
      <AAXMergeInput Include="$(OutDir)HarfBuzzSharp.dll" />
      <AAXMergeInput Include="$(OutDir)zxing.dll" />
      <AAXMergeInput Include="$(OutDir)SixLabors.ImageSharp.dll" />
      <AAXMergeInput Include="$(OutDir)System.Buffers.dll" />
      <AAXMergeInput Include="$(OutDir)System.Memory.dll" />
      <AAXMergeInput Include="$(OutDir)System.Numerics.Vectors.dll" />
      <AAXMergeInput Include="$(OutDir)System.Runtime.CompilerServices.Unsafe.dll" />
      <AAXMergeInput Include="$(OutDir)System.Text.Encoding.CodePages.dll" />
    </ItemGroup>
    <MakeDir Directories="$(AAXMergedDir)" />
    <Exec Command="&quot;$(AAXILRepackExe)&quot; /internalize /parallel /targetplatform:v4 /lib:&quot;$(AAXOut)&quot; /lib:&quot;$(AAXRefAsmDir)&quot; /out:&quot;$(AAXMergedDir)AtomicAx.Zpl.Render.dll&quot; @(AAXMergeInput->'&quot;%(FullPath)&quot;', ' ')" />
    <Message Importance="high" Text="AAX: ILRepack merged $(AAXMergedDir)AtomicAx.Zpl.Render.dll" />
  </Target>

  <!-- Deploy ONLY the merged standalone assembly; scrub every previously-shipped payload file
       so nothing stale can shadow it. -->
  <Target Name="AAXCopyToModelBin" AfterTargets="AAXILRepack" Condition="'$(TargetFramework)' == 'net472' and '$(AAXSkipDeploy)' != 'true'">
    <PropertyGroup>
      <AAXModelBin>C:\AOSService\PackagesLocalDirectory\AAXWarehouseTools\bin\</AAXModelBin>
    </PropertyGroup>
    <ItemGroup>
      <AAXStalePayload Include="$(AAXModelBin)BinaryKits.Zpl.Viewer.dll;$(AAXModelBin)BinaryKits.Zpl.Label.dll;$(AAXModelBin)SkiaSharp.dll;$(AAXModelBin)SkiaSharp.HarfBuzz.dll;$(AAXModelBin)HarfBuzzSharp.dll;$(AAXModelBin)zxing.dll;$(AAXModelBin)zxing.presentation.dll;$(AAXModelBin)SixLabors.ImageSharp.dll;$(AAXModelBin)System.Buffers.dll;$(AAXModelBin)System.Memory.dll;$(AAXModelBin)System.Numerics.Vectors.dll;$(AAXModelBin)System.Runtime.CompilerServices.Unsafe.dll;$(AAXModelBin)System.Text.Encoding.CodePages.dll;$(AAXModelBin)libSkiaSharp.dll;$(AAXModelBin)libHarfBuzzSharp.dll" />
    </ItemGroup>
    <MakeDir Directories="$(AAXModelBin)" />
    <Delete Files="@(AAXStalePayload)" ContinueOnError="true" />
    <RemoveDir Directories="$(AAXModelBin)runtimes" ContinueOnError="true" />
    <Copy SourceFiles="$(AAXMergedDir)AtomicAx.Zpl.Render.dll" DestinationFolder="$(AAXModelBin)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="AAX: deployed SINGLE standalone AtomicAx.Zpl.Render.dll to $(AAXModelBin) and scrubbed the old multi-DLL payload" />
  </Target>

</Project>
