<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RootNamespace>AtomicAx.Zpl.Render</RootNamespace>
    <AssemblyName>AtomicAx.Zpl.Render</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- net472 native asset resolution: emit the runtime DLLs into the build output. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- DR-2 APPLIED (2026-06-04): strong-naming removed. Build-time signing succeeded (CS8002
         warning only), but the .NET FRAMEWORK RUNTIME in the AOS enforces the rule the compiler
         no longer does: a strong-named assembly cannot LOAD unsigned dependencies
         (FUSION_E_SIGNATURE_CHECK_FAILED 0x80131044 on BinaryKits.Zpl.Viewer, PKT=null) — seen
         live on Feature A preview. net8 tests passed because modern .NET dropped that rule.
         Unsigned (PublicKeyToken=null) is the proven sibling precedent (F29/F35). -->
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned per WP-0.2 / F34 / DR-1. -->
    <PackageReference Include="BinaryKits.Zpl.Viewer" Version="1.3.1" />
    <!-- Windows native assets are NOT declared by the BinaryKits nuspec (it lists Linux only, F34)
         -> add explicitly, matching the SkiaSharp/HarfBuzzSharp line the Viewer resolves (3.119.1 / 8.3.x). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.2" />
  </ItemGroup>

  <!-- net472 needs reference assemblies for the build host; provide them via NuGet so the
       build is self-contained regardless of which targeting packs are installed. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- A classic net472 (non-self-contained) build does NOT auto-copy the win-x64 native
       assets out of the NuGet packages. Stage them into the build output's
       runtimes\win-x64\native so the lib is self-contained for the net8 test/probe and so the
       post-build model-bin copy has a single source. Paths resolved from the restored packages. -->
  <!-- ARCH-CORRECT native staging (U-1 round 3): SkiaSharp's own net4xx .targets drop an
       arch-picked native (x86 for AnyCPU!) into the build output ROOT — flat-copying *.dll
       therefore shipped an x86 libSkiaSharp into the 64-bit AOS (LoadLibrary error 193).
       Fix: never ship flat natives; stage BOTH win-x64 and win-x86 under runtimes\ and let
       the NativeLibraryPreloader pick by process bitness. -->
  <Target Name="AAXStageNatives" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net472'">
    <ItemGroup>
      <AAXNativeSrc Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.1\runtimes\win-x64\native\libSkiaSharp.dll" Arch="win-x64" />
      <AAXNativeSrc Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.1\runtimes\win-x86\native\libSkiaSharp.dll" Arch="win-x86" />
      <AAXNativeSrc Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\8.3.1.2\runtimes\win-x64\native\libHarfBuzzSharp.dll" Arch="win-x64" />
      <AAXNativeSrc Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\8.3.1.2\runtimes\win-x86\native\libHarfBuzzSharp.dll" Arch="win-x86" />
    </ItemGroup>
    <Copy SourceFiles="@(AAXNativeSrc)" DestinationFiles="@(AAXNativeSrc->'$(OutDir)runtimes\%(Arch)\native\%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

  <!-- WP-0.2 post-build copy: managed payload (EXCLUDING any stray root-level natives that
       SkiaSharp's targets placed there) + the full runtimes\ tree, structure preserved. -->
  <Target Name="AAXCopyToModelBin" AfterTargets="AAXStageNatives" Condition="'$(TargetFramework)' == 'net472'">
    <PropertyGroup>
      <AAXModelBin>C:\AOSService\PackagesLocalDirectory\AAXWarehouseTools\bin\</AAXModelBin>
    </PropertyGroup>
    <ItemGroup>
      <AAXManaged Include="$(OutDir)*.dll" Exclude="$(OutDir)libSkiaSharp.dll;$(OutDir)libHarfBuzzSharp.dll" />
      <AAXNative Include="$(OutDir)runtimes\**\*.dll" />
      <AAXStaleFlatNatives Include="$(AAXModelBin)libSkiaSharp.dll;$(AAXModelBin)libHarfBuzzSharp.dll" />
    </ItemGroup>
    <MakeDir Directories="$(AAXModelBin)" />
    <Delete Files="@(AAXStaleFlatNatives)" ContinueOnError="true" />
    <Copy SourceFiles="@(AAXManaged)" DestinationFolder="$(AAXModelBin)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(AAXNative)" DestinationFiles="@(AAXNative->'$(AAXModelBin)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="AAX: copied net472 managed DLLs + runtimes\win-x64+win-x86 natives to $(AAXModelBin)" />
  </Target>

</Project>
