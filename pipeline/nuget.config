<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure Artifacts feed holding the X++ build packages listed in packages.config. Forks point this
  at their own feed.
-->
<configuration>
	<packageSources>
		<clear />
		<add key="MVP-FO" value="https://nathanclouse.pkgs.visualstudio.com/MVP-FO/_packaging/MVP-FO/nuget/v3/index.json" />
	</packageSources>
</configuration>




