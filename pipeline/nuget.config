<?xml version="1.0" encoding="utf-8"?>
<!--
  Package source for the build reference packages. Replace the organization and feed names
  with the Azure Artifacts feed that holds the LCS packages listed in packages.config.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="D365BuildPackages" value="https://pkgs.dev.azure.com/ORGANIZATION/_packaging/FEED/nuget/v3/index.json" />
  </packageSources>
</configuration>
