<?xml version="1.0" encoding="utf-8"?>
<!--
  DevALM compiler packages restored by build-bismarck.yml.

  These versions are the ones that ACTUALLY EXIST in the 'Magicite' Azure Artifacts feed
  (project Magicate) referenced by nuget.config. The versions were picked 2026-08-10 against
  the now-deleted MVP-FO 'D365' feed, and re-verified in Magicite 2026-10-25:

      Microsoft.Dynamics.AX.Platform.CompilerPackage         7.0.7778.47
      Microsoft.Dynamics.AX.Platform.DevALM.BuildXpp         7.0.7778.47
      Microsoft.Dynamics.AX.Application1.DevALM.BuildXpp     10.0.2428.99
      Microsoft.Dynamics.AX.Application2.DevALM.BuildXpp     10.0.2428.99
      Microsoft.Dynamics.AX.ApplicationSuite.DevALM.BuildXpp 10.0.2428.99
      (the feed also carries a newer set, Platform 7.0.7858.163 / Application* 10.0.2527.196,
       and Microsoft.Dynamics.AX.Application.DevALM.BuildXpp 10.0.2527.196, the pre-split
       Application package — not needed alongside Application1/Application2)

  IMPORTANT: these must be <= the platform/application build of the TARGET environment
  (nclouse-bismarck). Compiling against an older platform than the target is fine;
  compiling against a NEWER one is not. For reference, the local dev box that this model
  is developed on is platform 7.0.7996.43 / ApplicationSuite model 10.39.1923.22741 — i.e.
  newer than the feed. If a build fails on a missing platform API, mirror the matching
  release from the LCS Shared Asset Library ("Nuget packages") into the feed and bump
  these versions together.
-->
<packages>
  <package id="Microsoft.Dynamics.AX.Platform.CompilerPackage"         version="7.0.7778.47"  targetFramework="net40" />
  <package id="Microsoft.Dynamics.AX.Platform.DevALM.BuildXpp"         version="7.0.7778.47"  targetFramework="net40" />
  <package id="Microsoft.Dynamics.AX.Application1.DevALM.BuildXpp"     version="10.0.2428.99" targetFramework="net40" />
  <package id="Microsoft.Dynamics.AX.Application2.DevALM.BuildXpp"     version="10.0.2428.99" targetFramework="net40" />
  <package id="Microsoft.Dynamics.AX.ApplicationSuite.DevALM.BuildXpp" version="10.0.2428.99" targetFramework="net40" />
</packages>
