<?xml version="1.0" encoding="utf-8"?>
<!--
  Build reference packages restored by the Azure DevOps pipeline (see azure-pipelines.yml).
  Download the four packages from LCS (Shared asset library > NuGet package) for the platform
  and application version of the target environment, push them to your Azure Artifacts feed,
  and set the versions below to the exact versions of the packages you pushed.
  The platform version equals the kernel build; the application version follows the
  Application Suite build.
-->
<packages>
  <package id="Microsoft.Dynamics.AX.Platform.CompilerPackage" version="7.0.7996.33" targetFramework="net40" />
  <package id="Microsoft.Dynamics.AX.Platform.DevALM.BuildXpp" version="7.0.7996.33" targetFramework="net40" />
  <package id="Microsoft.Dynamics.AX.Application.DevALM.BuildXpp" version="10.39.1864.12014" targetFramework="net40" />
  <package id="Microsoft.Dynamics.AX.ApplicationSuite.DevALM.BuildXpp" version="10.39.1864.12014" targetFramework="net40" />
</packages>
