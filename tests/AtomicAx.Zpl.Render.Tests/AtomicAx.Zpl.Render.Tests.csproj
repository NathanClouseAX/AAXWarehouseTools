<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted so the suite also runs on .NET Framework 4.7.2 — the AOS's runtime —
         where the NativeLibraryPreloader's embedded-resource native-extraction path
         (AAX.Natives.win-x64.* resources, net472-only) is actually exercised. On net8.0 the
         runtime resolves the win-x64 natives itself and the embedded path stays dormant. -->
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- SkiaSharp 3.x needs the win-x64 native asset at test runtime; force the RID so the
         native libSkiaSharp/libHarfBuzzSharp land beside the test assembly. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Project-reference the library; each test TFM resolves the matching library TFM
         (net472 test -> net472 library, net8.0 test -> net8.0 library) (REQ-R-5 / WP-0.3). -->
    <ProjectReference Include="..\..\Projects\AAXWarehouseTools\AtomicAx.Zpl.Render\AtomicAx.Zpl.Render.csproj" />
  </ItemGroup>

</Project>
